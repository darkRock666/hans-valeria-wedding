# Variables utilizadas solo en el servidor. Nunca usar el prefijo NEXT_PUBLIC_.
# URL publicada de la aplicación web de Apps Script; debe terminar en /exec.
GOOGLE_SHEETS_WEB_APP_URL=

# Secreto aleatorio de al menos 32 caracteres, idéntico a API_SECRET en Apps Script.
GOOGLE_SHEETS_SECRET=

# Contraseña independiente de al menos 24 caracteres para el panel /invitados.
ADMIN_PASSWORD=
